# Copie para .env e troque as senhas:  cp .env.example .env
# O .env NUNCA vai para o git.

POSTGRES_DB=academia
DB_PORT=5432

# Dono do banco (migrations / administração). NÃO usar na API.
POSTGRES_USER=academia_owner
POSTGRES_PASSWORD=troque-esta-senha-owner

# Usuário que a API usa (sem permissão de criar/apagar tabelas, sujeito ao RLS)
APP_DB_PASSWORD=troque-esta-senha-app

# true = carrega dados de teste (usuários, planos, treinos...). Só em desenvolvimento.
LOAD_SEED=true

# String de conexão para o backend:
# DATABASE_URL=postgresql://academia_app:troque-esta-senha-app@localhost:5432/academia
